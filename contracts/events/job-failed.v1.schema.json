{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greennode.local/contracts/events/job-failed.v1.schema.json",
  "title": "JobFailedV1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "traceparent",
    "correlationId",
    "causationId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "job.failed.v1" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceparent": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["jobId", "errorCode", "message"],
      "additionalProperties": false,
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "errorCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
